# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync (Claude Design): scripts, build e estado local
.ds-sync/
ds-bundle/
dist-ds/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Apurações: vídeos, áudios, quadros e prints ficam fora do git
apuracoes/*/midia/
# Cópias das fontes (reportagens de terceiros, PDFs) ficam só na máquina local;
# os links e as datas de acesso estão em cadeia.md
apuracoes/*/fontes/
